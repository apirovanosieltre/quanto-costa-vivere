{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quanto-costa-vivere",
  "compatibility_date": "2026-11-10",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/quanto-costa-vivere/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "costovita.cicioweb.app",
      "custom_domain": true
    }
  ]
}
